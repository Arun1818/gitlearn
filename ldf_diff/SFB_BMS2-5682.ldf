LIN_description_file;
LIN_protocol_version = "J2602_1_1.0";
LIN_language_version = "J2602_3_1.0";
LIN_speed = 10.417 kbps;

Nodes {
  Master: SFB, 10 ms, 0.05 ms;
  Slaves: BMS, BMS2, UCIM_UCIM2 ;
}

