Signal_encoding_types {
  LINStatus_ET {
    physical_value, 0, 255, 1, 0, "LIN Status" ;
  }
  BSBattCurrentCoding {
    physical_value, 0, 182272, 0.00390625, -512, "A" ;
  }
  BSBatt_Current_ASIL_Encoding {
    physical_value, 0, 182272, 0.00390625, -512, "A" ;
    logical_value, 16777215, "Invalid" ;
  }
  BSBattQCapAhLINCoding {
    physical_value, 0, 100, 1, 0, "Ah" ;
  }
  BSBattSOHSULStatusCoding {
    logical_value, 0, "Learning / relearning SUL" ;
    logical_value, 1, "SUL learning complete" ;
    logical_value, 2, "Reserved" ;
    logical_value, 3, "Reserved" ;
  }
  BSBattSOHLAMStatusCoding {
    logical_value, 0, "No detection or unknown" ;
    logical_value, 1, "Detected in the last 60 days" ;
    logical_value, 2, "Detected in the last 90 days" ;
    logical_value, 3, "Detected in more than 90 days" ;
  }
